rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    function myCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }
    match /companies/{companyId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if isAdmin() && myCompanyId() == companyId;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin() && resource.data.companyId == myCompanyId();
    }
    match /trips/{tripId} {
      allow create: if request.auth != null && request.resource.data.driverId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.driverId == request.auth.uid;
      allow read: if isAdmin() && resource.data.companyId == myCompanyId();
    }
    match /documents/{docId} {
      allow create: if isAdmin();
      allow read: if request.auth != null && (resource.data.driverId == request.auth.uid || (isAdmin() && resource.data.companyId == myCompanyId()));
      allow update: if isAdmin() && resource.data.companyId == myCompanyId();
      allow delete: if (isAdmin() && resource.data.companyId == myCompanyId()) || (request.auth != null && resource.data.driverId == request.auth.uid);
    }
    match /messages/{messageId} {
      allow create: if (isAdmin() &&
        request.resource.data.companyId == myCompanyId() &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.driverId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.driverId)).data.companyId == myCompanyId()
      ) || (
        request.auth != null &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.senderRole == "driver" &&
        request.resource.data.companyId == myCompanyId()
      );
      allow read: if request.auth != null && (resource.data.driverId == request.auth.uid || (isAdmin() && resource.data.companyId == myCompanyId()));
      allow update: if (isAdmin() && resource.data.companyId == myCompanyId()) || (request.auth != null && resource.data.driverId == request.auth.uid);
      allow delete: if (isAdmin() && resource.data.companyId == myCompanyId()) || (request.auth != null && resource.data.driverId == request.auth.uid);
    }
    match /timeOffRequests/{requestId} {
      // Drivers can submit their own requests
      allow create: if request.auth != null && request.resource.data.driverId == request.auth.uid;
      // Drivers can read their own; admins can read all requests for their company
      allow read: if request.auth != null && (resource.data.driverId == request.auth.uid || (isAdmin() && resource.data.companyId == myCompanyId()));
      // Only admins can approve/deny/mark paid, and only for their own company
      allow update: if isAdmin() && resource.data.companyId == myCompanyId();
      allow delete: if (isAdmin() && resource.data.companyId == myCompanyId()) || (request.auth != null && resource.data.driverId == request.auth.uid);
    }
  }
}